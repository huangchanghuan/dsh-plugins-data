{
  "name": "dsh-plugins-data",
  "version": "1.0.0",
  "private": true,
  "description": "DSH 插件目录数据与双端建站（DeepSeek Whale / Cloudflare Worker）",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "gen:wb": "python scripts/gen_site.py --out dist-wb",
    "check": "node scripts/check.mjs",
    "deploy": "npm run build && wrangler deploy",
    "dev": "npm run build && wrangler dev",
    "list": "node bin/dsh-plugins.mjs list",
    "sync": "node scripts/sync-catalog.mjs",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "wrangler": "^4.30.0"
  },
  "license": "MIT"
}
